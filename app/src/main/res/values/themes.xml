<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.EBondhon" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/primary_blue_dark</item>
        <item name="colorAccent">@color/red_accent</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
        <item name="android:statusBarColor">@color/primary_blue_dark</item>
    </style>

    <style name="Theme.EBondhon.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/light_cyan</item>
        <item name="android:statusBarColor">@color/light_cyan</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
    </style>

    <style name="AppBarStyle">
        <item name="android:background">@color/primary_blue</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="AppBarTitle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
    </style>

</resources>
