<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>পি.আর.এল বছর</h4>
</div>

<div class="card mb-3">
    <div class="card-header"><h6>নতুন বছর যোগ</h6></div>
    <div class="card-body">
        <form method="POST" action="/admin/prl/add" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">বছর (ইংরেজি) *</label>
                <input type="text" name="year" class="form-control" required placeholder="2024">
            </div>
            <div class="col-md-3">
                <label class="form-label">বছর (বাংলা)</label>
                <input type="text" name="yearBn" class="form-control" placeholder="২০২৪">
            </div>
            <div class="col-md-3">
                <label class="form-label">ক্রম</label>
                <input type="number" name="sortOrder" class="form-control" value="0">
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus"></i> যোগ</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr><th>বছর</th><th>বাংলা</th><th>ক্রম</th><th>অ্যাকশন</th></tr>
            </thead>
            <tbody>
                <% years.forEach(y => { %>
                <tr>
                    <td><%= y.year %></td>
                    <td><%= y.yearBn || '' %></td>
                    <td><%= y.sortOrder %></td>
                    <td>
                        <form method="POST" action="/admin/prl/delete/<%= y.year %>" style="display:inline" onsubmit="return confirm('মুছে ফেলতে চান?')">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
                <% }) %>
                <% if (years.length === 0) { %>
                <tr><td colspan="4" class="text-center text-muted">কোনো বছর নেই</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
