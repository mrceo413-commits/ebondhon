<h4 class="mb-3">যোগাযোগ তথ্য</h4>

<div class="card mb-4">
    <div class="card-header"><h5>মূল যোগাযোগ</h5></div>
    <div class="card-body">
        <form method="POST" action="/admin/contact/save">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">ওয়েবসাইট</label>
                    <input type="text" name="website" class="form-control" value="<%= contact ? contact.website || '' : '' %>">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">ফেসবুক</label>
                    <input type="text" name="facebook" class="form-control" value="<%= contact ? contact.facebook || '' : '' %>">
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">ফোন</label>
                    <input type="text" name="phone" class="form-control" value="<%= contact ? contact.phone || '' : '' %>">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">ইমেইল</label>
                    <input type="email" name="email" class="form-control" value="<%= contact ? contact.email || '' : '' %>">
                </div>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> সংরক্ষণ</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">গুরুত্বপূর্ণ লিংক</h5>
    </div>
    <div class="card-body">
        <form method="POST" action="/admin/contact/links/add" class="row g-2 align-items-end mb-3">
            <div class="col-md-3">
                <label class="form-label">শিরোনাম *</label>
                <input type="text" name="title" class="form-control" required>
            </div>
            <div class="col-md-4">
                <label class="form-label">URL *</label>
                <input type="text" name="url" class="form-control" required placeholder="https://...">
            </div>
            <div class="col-md-2">
                <label class="form-label">রঙ</label>
                <input type="color" name="color" class="form-control form-control-color" value="#1A237E">
            </div>
            <div class="col-md-2">
                <label class="form-label">ক্রম</label>
                <input type="number" name="sortOrder" class="form-control" value="0">
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus"></i></button>
            </div>
        </form>

        <table class="table table-sm">
            <thead><tr><th>শিরোনাম</th><th>URL</th><th>রঙ</th><th>অ্যাকশন</th></tr></thead>
            <tbody>
                <% links.forEach(l => { %>
                <tr>
                    <td><%= l.title %></td>
                    <td><a href="<%= l.url %>" target="_blank"><%= l.url %></a></td>
                    <td><span class="badge" style="background-color: <%= l.color %>"><%= l.color %></span></td>
                    <td>
                        <form method="POST" action="/admin/contact/links/delete/<%= l.id %>" style="display:inline" onsubmit="return confirm('মুছে ফেলতে চান?')">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
                <% }) %>
                <% if (links.length === 0) { %>
                <tr><td colspan="4" class="text-center text-muted">কোনো লিংক নেই</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
