<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>গুরুত্বপূর্ণ টেলিফোন নম্বর</h4>
</div>

<div class="card mb-3">
    <div class="card-header"><h6>নতুন নম্বর যোগ</h6></div>
    <div class="card-body">
        <form method="POST" action="/admin/phones/add" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">নাম *</label>
                <input type="text" name="name" class="form-control" required>
            </div>
            <div class="col-md-3">
                <label class="form-label">ফোন নম্বর *</label>
                <input type="text" name="phone" class="form-control" required>
            </div>
            <div class="col-md-3">
                <label class="form-label">পদবী</label>
                <input type="text" name="designation" class="form-control">
            </div>
            <div class="col-md-2">
                <label class="form-label">ক্রম</label>
                <input type="number" name="sortOrder" class="form-control" value="0">
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr><th>#</th><th>নাম</th><th>পদবী</th><th>ফোন</th><th>অ্যাকশন</th></tr>
            </thead>
            <tbody>
                <% phones.forEach((p, i) => { %>
                <tr>
                    <td><%= i + 1 %></td>
                    <td><%= p.name %></td>
                    <td><%= p.designation || '' %></td>
                    <td><%= p.phone %></td>
                    <td>
                        <form method="POST" action="/admin/phones/delete/<%= p.id %>" style="display:inline" onsubmit="return confirm('মুছে ফেলতে চান?')">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
                <% }) %>
                <% if (phones.length === 0) { %>
                <tr><td colspan="5" class="text-center text-muted">কোনো নম্বর নেই</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
