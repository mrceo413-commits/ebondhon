<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><h5><%= dept ? 'বিভাগ সম্পাদনা' : 'নতুন বিভাগ' %> — <%= faculty ? faculty.name : '' %></h5></div>
            <div class="card-body">
                <form method="POST" action="<%= dept ? '/admin/departments/edit/' + dept.id : '/admin/departments/add' %>">
                    <input type="hidden" name="facultyId" value="<%= faculty ? faculty.id : (dept ? dept.facultyId : '') %>">
                    <% if (!dept) { %>
                    <div class="mb-3">
                        <label class="form-label">আইডি (ইউনিক)</label>
                        <input type="text" name="id" class="form-control" required>
                    </div>
                    <% } %>
                    <div class="mb-3">
                        <label class="form-label">বিভাগের নাম (বাংলা)</label>
                        <input type="text" name="name" class="form-control" value="<%= dept ? dept.name : '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">বিভাগের নাম (ইংরেজি)</label>
                        <input type="text" name="nameEn" class="form-control" value="<%= dept ? dept.nameEn || '' : '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ক্রম</label>
                        <input type="number" name="sortOrder" class="form-control" value="<%= dept ? dept.sortOrder : 0 %>">
                    </div>
                    <button type="submit" class="btn btn-primary">সংরক্ষণ</button>
                    <a href="/admin/faculties" class="btn btn-secondary">বাতিল</a>
                </form>
            </div>
        </div>
    </div>
</div>
