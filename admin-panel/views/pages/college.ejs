<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>কলেজ তথ্য</h4>
    <a href="/admin/college/add" class="btn btn-primary"><i class="bi bi-plus-lg"></i> নতুন যোগ</a>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr><th>#</th><th>শিরোনাম</th><th>ধরন</th><th>ক্রম</th><th>অ্যাকশন</th></tr>
            </thead>
            <tbody>
                <% items.forEach((item, i) => { %>
                <tr>
                    <td><%= i + 1 %></td>
                    <td><%= item.title %></td>
                    <td><span class="badge bg-secondary"><%= item.type %></span></td>
                    <td><%= item.sortOrder %></td>
                    <td>
                        <a href="/admin/college/edit/<%= item.id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <form method="POST" action="/admin/college/delete/<%= item.id %>" style="display:inline" onsubmit="return confirm('মুছে ফেলতে চান?')">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
                <% }) %>
                <% if (items.length === 0) { %>
                <tr><td colspan="5" class="text-center text-muted">কোনো তথ্য নেই</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
