<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><h5><%= council ? 'পরিষদ সম্পাদনা' : 'নতুন পরিষদ' %></h5></div>
            <div class="card-body">
                <form method="POST" action="<%= council ? '/admin/councils/edit/' + council.id : '/admin/councils/add' %>">
                    <% if (!council) { %>
                    <div class="mb-3">
                        <label class="form-label">আইডি (ইউনিক)</label>
                        <input type="text" name="id" class="form-control" required>
                    </div>
                    <% } %>
                    <div class="mb-3">
                        <label class="form-label">পরিষদের নাম</label>
                        <input type="text" name="name" class="form-control" value="<%= council ? council.name : '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ক্রম</label>
                        <input type="number" name="sortOrder" class="form-control" value="<%= council ? council.sortOrder : 0 %>">
                    </div>
                    <button type="submit" class="btn btn-primary">সংরক্ষণ</button>
                    <a href="/admin/councils" class="btn btn-secondary">বাতিল</a>
                </form>
            </div>
        </div>
    </div>
</div>
