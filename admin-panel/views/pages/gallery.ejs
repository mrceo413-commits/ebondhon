<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>ফটো গ্যালারি</h4>
</div>

<div class="card mb-3">
    <div class="card-header"><h6>নতুন ফটো যোগ</h6></div>
    <div class="card-body">
        <form method="POST" action="/admin/gallery/add" enctype="multipart/form-data" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">ছবি আপলোড</label>
                <input type="file" name="photo" class="form-control" accept="image/*">
            </div>
            <div class="col-md-3">
                <label class="form-label">অথবা URL</label>
                <input type="text" name="url" class="form-control" placeholder="https://...">
            </div>
            <div class="col-md-3">
                <label class="form-label">ক্যাপশন</label>
                <input type="text" name="caption" class="form-control">
            </div>
            <div class="col-md-1">
                <label class="form-label">ক্রম</label>
                <input type="number" name="sortOrder" class="form-control" value="0">
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <% photos.forEach(photo => { %>
    <div class="col-md-4 mb-3">
        <div class="card">
            <img src="<%= photo.url %>" class="card-img-top" style="height: 200px; object-fit: cover;" alt="<%= photo.caption || '' %>">
            <div class="card-body d-flex justify-content-between align-items-center p-2">
                <small class="text-muted"><%= photo.caption || 'No caption' %></small>
                <form method="POST" action="/admin/gallery/delete/<%= photo.id %>" onsubmit="return confirm('মুছে ফেলতে চান?')">
                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
            </div>
        </div>
    </div>
    <% }) %>
    <% if (photos.length === 0) { %>
    <div class="col-12"><div class="alert alert-info">কোনো ফটো নেই।</div></div>
    <% } %>
</div>
